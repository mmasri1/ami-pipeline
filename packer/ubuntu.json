{
  "variables": {
    "aws_region": "us-east-1",
    "ami_name": "ubuntu-hardened-{{timestamp}}"
  },
  "builders": [
    {
      "type": "amazon-ebs",
      "region": "{{user `aws_region`}}",
      "source_ami_filter": {
        "filters": {
          "virtualization-type": "hvm",
          "name": "ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*",
          "root-device-type": "ebs"
        },
        "owners": ["099720109477"],
        "most_recent": true
      },
      "instance_type": "t3.micro",
      "ssh_username": "ubuntu",
      "ami_name": "{{user `ami_name`}}"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "sudo apt update -y",
        "sudo apt upgrade -y",
        "sudo apt install -y vim curl git"
      ]
    },
    {
      "type": "shell",
      "inline": [
        "echo 'Installing Ubuntu Security Guide...'",
        "sudo add-apt-repository ppa:ubuntu-security/ppa -y",
        "sudo apt update -y",
        "sudo apt install -y usg"
      ]
    },
    {
      "type": "shell",
      "inline": [
        "echo 'Running CIS Level 1 Hardening...'",
        "sudo usg fix cis_level1_server",
        "echo 'Generating report...' ",
        "sudo usg cis_level1_server > /home/ubuntu/cis_report.txt"
      ]
    }
  ]
}
